#: view/common/block-layout/admin/vikus-form.phtml:20
msgid ""
"The data and the sprites are generated by a background job when the page is "
"saved and an option changed. Check \"Regenerate on save\" to include the "
"items added since."
msgstr ""
"Les données et les sprites sont générés par une tâche de fond lors de "
"l’enregistrement de la page, quand une option a changé. Cochez « Régénérer à "
"l’enregistrement » pour inclure les contenus ajoutés depuis."

#: view/common/block-layout/admin/vikus-form.phtml:23
msgid "The count of the items of the query is not available."
msgstr "Le nombre de contenus de la requête n’est pas disponible."

#: view/common/block-layout/admin/vikus-form.phtml:27
#, php-format
msgid "Items of the query: %s."
msgstr "Contenus de la requête : %s."

#: view/common/block-layout/admin/vikus-form.phtml:32
#, php-format
msgid "Displayed items: %d."
msgstr "Contenus affichés : %d."

#: view/common/block-layout/admin/vikus-form.phtml:38
#, php-format
msgid "Above %d items, the viewer is slow on laptops and phones."
msgstr ""
"Au-delà de %d contenus, la visionneuse est lente sur les ordinateurs "
"portables et les téléphones."

#: view/common/block-layout/admin/vikus-form.phtml:43
#, php-format
msgid "Above %d items, the viewer is not usable on most devices."
msgstr ""
"Au-delà de %d contenus, la visionneuse n’est pas utilisable sur la plupart "
"des appareils."

#: view/common/vikus.phtml:19
msgid "The visualization is being generated."
msgstr "La visualisation est en cours de génération."

#: view/common/vikus.phtml:21
msgid "No item with an image."
msgstr "Aucun contenu avec une image."

#: view/common/vikus.phtml:23
msgid "Vikus Viewer"
msgstr "Visionneuse Vikus"

#: view/common/vikus.phtml:24
msgid "Full view"
msgstr "Pleine vue"

#: Module.php:81 Module.php:89
msgid ""
"The library \"{library}\" should be installed. See module’s installation "
"documentation."
msgstr ""
"La bibliothèque « {library} » doit être installée. Voir la documentation "
"d’installation du module."

#: Module.php:97
msgid ""
"The php extension \"imagick\" or \"gd\" is required to build the sprites."
msgstr ""
"L’extension php « imagick » ou « gd » est requise pour construire les "
"sprites."

#: Module.php:105
msgid "The directory \"{directory}\" is not writeable."
msgstr "Le dossier « {directory} » n’est pas accessible en écriture."

#: Module.php:282 src/Stdlib/Generator.php:66
msgid "Vikus cache \"{key}\": {message}"
msgstr "Cache Vikus « {key} » : {message}"

#: src/Job/GenerateData.php:33
msgid "The cache \"{key}\" is not a Vikus one."
msgstr "Le cache « {key} » n’est pas un cache Vikus."

#: src/Job/GenerateData.php:56 src/Job/GenerateData.php:66
msgid "Vikus cache \"{key}\": the generation was stopped."
msgstr "Cache Vikus « {key} » : la génération a été arrêtée."

#: src/Job/GenerateData.php:107
msgid ""
"Vikus cache \"{key}\": the options changed during the generation, the result "
"was discarded."
msgstr ""
"Cache Vikus « {key} » : les options ont changé durant la génération, le "
"résultat a été abandonné."

#: src/Job/GenerateData.php:121
msgid "Vikus cache \"{key}\": no item with an image."
msgstr "Cache Vikus « {key} » : aucun contenu avec une image."

#: src/Job/GenerateData.php:127
msgid ""
"Vikus cache \"{key}\": the thumbnail of {count} items is not readable: "
"{item_ids}."
msgstr ""
"Cache Vikus « {key} » : la vignette de {count} contenus n’est pas lisible : "
"{item_ids}."

#: src/Job/GenerateData.php:132
msgid "Vikus cache \"{key}\": {total} items generated."
msgstr "Cache Vikus « {key} » : {total} contenus générés."

#: src/Form/SettingsFieldset.php:26
msgid "Hard limit of items by visualization"
msgstr "Limite absolue de contenus par visualisation"

#: src/Form/SettingsFieldset.php:27
msgid ""
"Safety limit of the background job, that the option of a block or of a site "
"cannot exceed."
msgstr ""
"Limite de sécurité de la tâche de fond, que l’option d’un bloc ou d’un site "
"ne peut pas dépasser."

#: src/Form/VikusFieldset.php:14
msgid "Font color"
msgstr "Couleur du texte"

#: src/Form/VikusFieldset.php:15
msgid "Font color of the active keyword"
msgstr "Couleur du texte du mot-clé actif"

#: src/Form/VikusFieldset.php:16
msgid "Background of the active keyword"
msgstr "Fond du mot-clé actif"

#: src/Form/VikusFieldset.php:17
msgid "Background of the canvas"
msgstr "Fond du canevas"

#: src/Form/VikusFieldset.php:18
msgid "Background of the timeline"
msgstr "Fond de la frise chronologique"

#: src/Form/VikusFieldset.php:19
msgid "Font color of the timeline"
msgstr "Couleur du texte de la frise chronologique"

#: src/Form/VikusFieldset.php:20
msgid "Background of the header"
msgstr "Fond de l’en-tête"

#: src/Form/VikusFieldset.php:21
msgid "Font color of the header"
msgstr "Couleur du texte de l’en-tête"

#: src/Form/VikusFieldset.php:22
msgid "Background of the detail panel"
msgstr "Fond du panneau de détail"

#: src/Form/VikusFieldset.php:23
msgid "Background of the info panel"
msgstr "Fond du panneau d’information"

#: src/Form/VikusFieldset.php:24
msgid "Font color of the info panel"
msgstr "Couleur du texte du panneau d’information"

#: src/Form/VikusFieldset.php:25
msgid "Background of the search bar"
msgstr "Fond de la barre de recherche"

#: src/Form/VikusFieldset.php:58
msgid "Layouts"
msgstr "Dispositions"

#: src/Form/VikusFieldset.php:79
msgid "Images"
msgstr "Images"

#: src/Form/VikusFieldset.php:83
msgid "Style"
msgstr "Style"

#: src/Form/VikusFieldset.php:128
msgid "Items to display"
msgstr "Contenus à afficher"

#: src/Form/VikusFieldset.php:129
msgid "Only items of the site with an image are displayed."
msgstr "Seuls les contenus du site possédant une image sont affichés."

#: src/Form/VikusFieldset.php:143
msgid "Maximum number of items"
msgstr "Nombre maximum de contenus"

#: src/Form/VikusFieldset.php:144
msgid ""
"Leave empty to keep all the items of the query. The viewer stays smooth up "
"to about 2000 items on laptops and phones."
msgstr ""
"Laisser vide pour garder tous les contenus de la requête. La visionneuse "
"reste fluide jusqu’à environ 2000 contenus sur les ordinateurs portables et "
"les téléphones."

#: src/Form/VikusFieldset.php:157
msgid "The title of the page is used when empty."
msgstr "Le titre de la page est utilisé lorsque ce champ est vide."

#: src/Form/VikusFieldset.php:167
msgid "Presentation (markdown)"
msgstr "Présentation (markdown)"

#: src/Form/VikusFieldset.php:178
msgid "Regenerate on save"
msgstr "Régénérer à l’enregistrement"

#: src/Form/VikusFieldset.php:179
msgid ""
"The data and the sprites are rebuilt only when an option changes. Check to "
"include the items added or modified since the last generation. The box is "
"not kept."
msgstr ""
"Les données et les sprites ne sont reconstruits que lorsqu’une option "
"change. Cochez pour inclure les contenus ajoutés ou modifiés depuis la "
"dernière génération. La case n’est pas conservée."

#: src/Form/VikusFieldset.php:189
msgid "Events of the timeline"
msgstr "Événements de la frise chronologique"

#: src/Form/VikusFieldset.php:190
msgid ""
"Write one event by line like \"1789 = Night of the 4th August = Abolition of "
"feudalism = Extra note\". Only the year is required."
msgstr ""
"Indiquez un événement par ligne, par exemple « 1789 = Nuit du 4 août = "
"Abolition des privilèges = Note complémentaire ». Seule l’année est requise."

#: src/Form/VikusFieldset.php:199 src/Form/VikusFieldset.php:246
msgid "Year"
msgstr "Année"

#: src/Form/VikusFieldset.php:200
msgid "Title = text = extra note"
msgstr "Titre = texte = note complémentaire"

#: src/Form/VikusFieldset.php:213
msgid "Property for the year"
msgstr "Propriété pour l’année"

#: src/Form/VikusFieldset.php:214
msgid "The first number of four digits of the first value is used."
msgstr ""
"Le premier nombre de quatre chiffres de la première valeur est utilisé."

#: src/Form/VikusFieldset.php:221 src/Form/VikusFieldset.php:236
msgid "Select a property…"
msgstr "Sélectionnez une propriété…"

#: src/Form/VikusFieldset.php:228
msgid "Property of the annotation carrying the year"
msgstr "Propriété de l’annotation portant l’année"

#: src/Form/VikusFieldset.php:229
msgid ""
"When set, the year is read in this property of the value annotations of the "
"values of \"Property for the year\". When empty, the value itself is used."
msgstr ""
"Quand elle est définie, l’année est lue dans cette propriété des annotations "
"de valeur des valeurs de « Propriété pour l’année ». Quand elle est vide, la "
"valeur elle-même est utilisée."

#: src/Form/VikusFieldset.php:243
msgid "Precision of the year"
msgstr "Précision de l’année"

#: src/Form/VikusFieldset.php:244
msgid ""
"The year is rounded down to the first year of its decade or of its century, "
"so the columns of the time layout are wider and the images are bigger at the "
"first display."
msgstr ""
"L’année est arrondie à la première année de sa décennie ou de son siècle, de "
"sorte que les colonnes de la frise sont plus larges et les images plus "
"grandes dès le premier affichage."

#: src/Form/VikusFieldset.php:247
msgid "Decade"
msgstr "Décennie"

#: src/Form/VikusFieldset.php:248
msgid "Century"
msgstr "Siècle"

#: src/Form/VikusFieldset.php:259
msgid "Properties for the keywords"
msgstr "Propriétés pour les mots-clés"

#: src/Form/VikusFieldset.php:266 src/Form/VikusFieldset.php:296
#: src/Form/VikusFieldset.php:311
msgid "Select properties…"
msgstr "Sélectionnez des propriétés…"

#: src/Form/VikusFieldset.php:273
msgid "Mode of the filter"
msgstr "Mode du filtre"

#: src/Form/VikusFieldset.php:274
msgid ""
"With the hierarchical mode, the keywords are split on \":\" to build levels. "
"With the crossfilter, each property of the keywords is a facet."
msgstr ""
"Avec le mode hiérarchique, les mots-clés sont découpés sur « : » pour former "
"des niveaux. Avec le crossfilter, chaque propriété des mots-clés est une "
"facette."

#: src/Form/VikusFieldset.php:276
msgid "Keywords (tag cloud)"
msgstr "Mots-clés (nuage de tags)"

#: src/Form/VikusFieldset.php:277
msgid "Hierarchical keywords"
msgstr "Mots-clés hiérarchiques"

#: src/Form/VikusFieldset.php:278
msgid "Crossfilter (facets by property)"
msgstr "Filtre croisé (facettes par propriété)"

#: src/Form/VikusFieldset.php:289
msgid "Properties of the detail panel"
msgstr "Propriétés du panneau de détail"

#: src/Form/VikusFieldset.php:303
msgid "Properties for the group layouts"
msgstr "Propriétés pour les dispositions par groupe"

#: src/Form/VikusFieldset.php:304
msgid ""
"A layout is added to the navigation for each property: the items are grouped "
"by their first value."
msgstr ""
"Une disposition est ajoutée à la navigation pour chaque propriété : les "
"contenus sont regroupés selon leur première valeur."

#: src/Form/VikusFieldset.php:318
msgid "Titles of the layouts"
msgstr "Titres des dispositions"

#: src/Form/VikusFieldset.php:319
msgid ""
"Write one title by line like \"dcterms:subject = Themes\". The label of the "
"property is used when it is not set. The two keys \"time\" and \"map\", to "
"be typed by hand, rename the time layout and the map layout. A short title "
"is advised: the navigation buttons of the viewer are narrow."
msgstr ""
"Écrire un titre par ligne comme « dcterms:subject = Thèmes ». Le libellé de "
"la propriété est utilisé quand il n’est pas défini. Les deux clés « time » "
"et « map », à saisir à la main, renomment la disposition par temps et celle "
"par carte. Un titre court est conseillé : les boutons de navigation de la "
"visionneuse sont étroits."

#: src/Form/VikusFieldset.php:344
msgid "Add a map layout (module Mapping)"
msgstr "Ajouter une disposition en carte (module Mapping)"

#: src/Form/VikusFieldset.php:345
msgid ""
"A layout is added to the navigation with the items having a point. The other "
"items are hidden in it."
msgstr ""
"Une disposition est ajoutée à la navigation avec les contenus ayant un "
"point. Les autres contenus y sont masqués."

#: src/Form/VikusFieldset.php:355
msgid "Isolated points of the map"
msgstr "Points isolés de la carte"

#: src/Form/VikusFieldset.php:356
msgid ""
"The map fills the canvas, so a few distant points reduce the area where most "
"of the items are to a few pixels. The isolated points are moved to the "
"border of that area, or hidden on the map only, or kept where they are. "
"Below fifty points, nothing is done."
msgstr ""
"La carte remplit le canevas, donc quelques points lointains réduisent à "
"quelques pixels l’aire où se trouve l’essentiel des contenus. Les points "
"isolés sont déplacés sur le bord de cette aire, ou masqués sur la carte "
"seulement, ou conservés là où ils sont. En dessous de cinquante points, rien "
"n’est fait."

#: src/Form/VikusFieldset.php:358
msgid "Move them to the border of the dense area"
msgstr "Les déplacer sur le bord de l’aire dense"

#: src/Form/VikusFieldset.php:359
msgid "Hide them on the map"
msgstr "Les masquer sur la carte"

#: src/Form/VikusFieldset.php:360
msgid "Keep them where they are"
msgstr "Les conserver là où ils sont"

#: src/Form/VikusFieldset.php:371
msgid "Tiles of the base map"
msgstr "Tuiles du fond de carte"

#: src/Form/VikusFieldset.php:372
msgid ""
"Url template of a tile server, with the placeholders {z}, {x} and {y}. The "
"tiles of OpenStreetMap are not meant for a public site: use a self-hosted or "
"a licensed tile server."
msgstr ""
"Gabarit d’url d’un serveur de tuiles, avec les marqueurs {z}, {x} et {y}. "
"Les tuiles d’OpenStreetMap ne sont pas prévues pour un site public : "
"utilisez un serveur de tuiles hébergé par vos soins ou sous licence."

#: src/Form/VikusFieldset.php:383
msgid "Attribution of the base map"
msgstr "Attribution du fond de carte"

#: src/Form/VikusFieldset.php:384
msgid ""
"Displayed in the corner of the map, as the licence of the tiles requires it."
msgstr ""
"Affichée dans le coin de la carte, comme la licence des tuiles l’exige."

#: src/Form/VikusFieldset.php:395
msgid "Opacity of the base map"
msgstr "Opacité du fond de carte"

#: src/Form/VikusFieldset.php:396
msgid "From 0 (invisible) to 1 (full): a faded map keeps the images readable."
msgstr ""
"De 0 (invisible) à 1 (pleine) : une carte estompée garde les images lisibles."

#: src/Form/VikusFieldset.php:409
msgid "Hide the items without coordinates"
msgstr "Masquer les items sans coordonnées"

#: src/Form/VikusFieldset.php:410
msgid ""
"The viewer keeps the items absent from the file of the layout in the canvas, "
"dimmed and laid out on a ring around the map. Check this option to make them "
"fully transparent on the map layout, where they mean nothing. The items "
"excluded by the current filter are hidden the same way on this layout."
msgstr ""
"Le viewer garde dans le canevas les items absents du fichier du layout, "
"atténués sur un anneau autour de la carte. Cochez cette option pour les "
"rendre entièrement transparents sur le layout de carte, où ils n’ont pas de "
"sens. Les items écartés par le filtre courant sont masqués de la même façon "
"sur ce layout."

#: src/Form/VikusFieldset.php:420
msgid "Source of the detailed images"
msgstr "Source des images détaillées"

#: src/Form/VikusFieldset.php:422
msgid "Automatic (iiif when available)"
msgstr "Automatique (iiif lorsque disponible)"

#: src/Form/VikusFieldset.php:423
msgid "Omeka (large and original)"
msgstr "Omeka (grande et originale)"

#: src/Form/VikusFieldset.php:424
msgid "IIIF image server"
msgstr "Serveur d’images IIIF"

#: src/Form/VikusFieldset.php:435
msgid "Size of the sprites (px)"
msgstr "Taille des sprites (px)"

#: src/Form/VikusFieldset.php:436
msgid ""
"The thumbnails are packed in atlases of 2048 px. A smaller size divides the "
"number of atlases by four, so the memory of the graphic card too, but the "
"images are blurry when the visitor zooms in."
msgstr ""
"Les vignettes sont rangées dans des atlas de 2048 px. Une taille plus petite "
"divise par quatre le nombre d’atlas, donc la mémoire de la carte graphique, "
"mais les images sont floues quand le visiteur zoome."

#: src/Form/VikusFieldset.php:450
msgid "Add a link to the item in the detail panel"
msgstr "Ajouter un lien vers le contenu dans le panneau de détail"

#: src/Form/VikusFieldset.php:460
msgid "Number of columns by year"
msgstr "Nombre de colonnes par année"

#: src/Form/VikusFieldset.php:472
msgid "Height of the viewer (css)"
msgstr "Hauteur de la visionneuse (css)"

#: src/Controller/PlayerController.php:223
msgid "Regenerate"
msgstr "Régénérer"
