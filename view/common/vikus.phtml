<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SiteRepresentation $site
 * @var string $key
 * @var string $status "ready", "empty" or "pending"
 * @var string $height
 * @var string|null $url
 * @var string|null $fullUrl
 */

$plugins = $this->getHelperPluginManager();
$escape = $plugins->get('escapeHtml');
$translate = $plugins->get('translate');
$escapeAttr = $plugins->get('escapeHtmlAttr');
?>

<?php if ($status === 'pending'): ?>
<p class="vikus-pending"><?= $escape($translate('The visualization is being generated.')) ?></p>
<?php elseif ($status === 'empty'): ?>
<p class="vikus-empty"><?= $escape($translate('No item with an image.')) ?></p>
<?php else: ?>
<iframe class="vikus-viewer" src="<?= $escapeAttr($url) ?>" style="height: <?= $escapeAttr($height) ?>;" allowfullscreen="allowfullscreen" loading="lazy" title="<?= $escapeAttr($translate('Vikus Viewer')) ?>"></iframe>
<p class="vikus-links"><a class="vikus-full" href="<?= $escapeAttr($fullUrl) ?>" target="_blank"><?= $escape($translate('Full view')) ?></a></p>
<?php endif; ?>
