<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Vikus\Form\VikusFieldset $fieldset
 * @var array $query
 * @var int|null $itemCount
 * @var int|null $generatedCount
 * @var array $thresholds
 */

$plugins = $this->getHelperPluginManager();
$url = $plugins->get('url');
$translate = $plugins->get('translate');
$hyperlink = $plugins->get('hyperlink');

$level = $generatedCount === null
    ? ''
    : \Vikus\Site\BlockLayout\Vikus::warningLevel($generatedCount, $thresholds);
?>
<p class="explanation"><?= $this->escapeHtml($translate('The data and the sprites are generated by a background job when the page is saved and an option changed. Check "Regenerate on save" to include the items added since.')) ?></p>
<p><?php
if ($itemCount === null):
    echo $translate('The count of the items of the query is not available.'); // @translate
else:
    // The "%s" carries the hyperlink markup of the count, not a number.
    echo sprintf(
        $translate('Items of the query: %s.'), // @translate
        $hyperlink($itemCount, $url('admin/default', ['controller' => 'item'], ['query' => $query]))
    );
    if ($generatedCount < $itemCount) {
        echo ' ' . sprintf(
            $translate('Displayed items: %d.'), // @translate
            $generatedCount
        );
    }
    if ($level === 'warn') {
        echo ' ' . sprintf(
            $translate('Above %d items, the viewer is slow on laptops and phones.'), // @translate
            $thresholds['warn']
        );
    } elseif ($level === 'max_recommended') {
        echo ' ' . sprintf(
            $translate('Above %d items, the viewer is not usable on most devices.'), // @translate
            $thresholds['max_recommended']
        );
    }
endif;
?></p>
<?= $this->formCollectionElementGroupsCollapsible($fieldset) ?>
