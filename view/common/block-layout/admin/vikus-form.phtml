<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Vikus\Form\VikusFieldset $fieldset
 * @var array $query
 * @var int $itemCount
 * @var array $thresholds
 * @var int $maxItems
 */

$plugins = $this->getHelperPluginManager();
$url = $plugins->get('url');
$translate = $plugins->get('translate');
$hyperlink = $plugins->get('hyperlink');

$level = \Vikus\Site\BlockLayout\Vikus::warningLevel($itemCount, $thresholds);
?>
<p class="explanation"><?= $this->escapeHtml($translate('The data and the sprites are generated by a background job when the page is saved. Use the button "Regenerate" of the full page of the viewer to include new items.')) ?></p>
<p><?php
    echo sprintf(
        $translate('There are currently %s items in the pool of this visualization.'), // @translate
        $hyperlink($itemCount, $url('admin/default', ['controller' => 'item'], ['query' => $query]))
    );
    if ($level === 'warn') {
        echo ' ' . sprintf(
            $translate('Above %d items the viewer becomes slow on laptops and phones: restrict the query or use a smaller sprite size.'), // @translate
            $thresholds['warn']
        );
    } elseif ($level === 'max_recommended') {
        echo ' ' . sprintf(
            $translate('Above %d items the viewer is not usable on most devices: restrict the query.'), // @translate
            $thresholds['max_recommended']
        );
    }
    if ($itemCount > $maxItems) {
        echo ' ' . sprintf(
            $translate('The generation stops at %d items (main setting).'), // @translate
            $maxItems
        );
    }
?></p>
<?= $this->formCollection($fieldset, false) ?>
